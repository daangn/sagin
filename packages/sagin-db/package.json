{
  "name": "@sagin/db",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./auth": "./src/auth.ts",
    "./schema": "./src/schema.ts",
    "./pool": "./src/pool.ts"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./lib/index.d.ts",
        "import": "./lib/index.js"
      },
      "./auth": {
        "types": "./lib/auth.d.ts",
        "import": "./lib/auth.js"
      },
      "./schema": {
        "types": "./lib/schema.d.ts",
        "import": "./lib/schema.js"
      },
      "./pool": {
        "types": "./lib/pool.d.ts",
        "import": "./lib/pool.js"
      }
    }
  },
  "scripts": {
    "generate": "drizzle-kit generate:pg && vite-node scripts/generate-dbml.ts",
    "push": "drizzle-kit push:pg",
    "studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@auth/core": "^0.18.1",
    "@paralleldrive/cuid2": "^2.2.2",
    "@sagin/core": "workspace:^",
    "drizzle-orm": "^0.29.0",
    "pg": "^8.11.3"
  },
  "devDependencies": {
    "@types/pg": "^8.10.9",
    "drizzle-dbml-generator": "^0.5.0",
    "drizzle-kit": "^0.20.2",
    "typescript": "^5.2.2",
    "vite": "^5.0.2",
    "vite-node": "0.34.6"
  }
}
