{
  "name": "@sagin/indexer",
  "type": "module",
  "scripts": {
    "build": "vite build"
  },
  "exports": {
    "./schema/*.json": "./src/schema/*.json",
    "./schema/*.ts": "./src/schema/*.ts",
    "./services": "./src/services.ts",
    "./api/trpc": "./src/api/trpc.ts"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      "./schema/*.json": "./dist/schema/*.json",
      "./services": {
        "types": "./dist/services.d.ts",
        "import": "./dist/services.js"
      },
      "./api/trpc": {
        "types": "./dist/api/trpc.d.ts",
        "import": "./dist/api/trpc.js"
      }
    }
  },
  "peerDependencies": {
    "@trpc/server": "^10.0.0",
    "zod": "^3.0.0"
  },
  "peerDependenciesMeta": {
    "@trpc/server": {
      "optional": true
    }
  },
  "devDependencies": {
    "@trpc/server": "^10.45.0",
    "json-schema-to-ts": "^3.0.0",
    "typescript": "^5.3.3",
    "vite": "^6.4.4",
    "zod": "^3.22.4"
  }
}
